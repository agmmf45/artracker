# Local development only — copy to .dev.vars (gitignored). Never commit real values.
# Multiplies every rate limit so integration tests can create many accounts quickly.
RATE_LIMIT_SCALE=1000

# Optional server secrets (production: `wrangler secret put <NAME>`):
# ANTHROPIC_API_KEY=   # enables /api/ai/* (assistant, meal photo analysis, SMS parsing via AI)
# EXERCISEDB_KEY=      # enables /api/exercises (exercise images & instructions)

# Public config lives in wrangler.jsonc [vars]: GOOGLE_CLIENT_ID, AI_MODEL
